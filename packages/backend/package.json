{
    "name": "himalayan-drumming-research-server",
    "version": "1.0.0",
    "main": "dist/index.js",
    "author": "Scott Fasone",
    "license": "MIT",
    "scripts": {
        "lint": "eslint ./src",
        "lint:fix": "eslint --fix ./src",
        "typecheck": "tsc --noEmit -p . --pretty",
        "generate": "pnpm run generate:nexus",
        "generate:nexus": "NEXUS_GEN=1 tsx ./src/graphql/index.ts",
        "generate:nexus:watch": "NEXUS_GEN=1 tsx --watch ./src/graphql/index.ts",
        "db:seed": "tsx ./src/scripts/db_seed.ts",
        "db:scan": "tsx ./src/scripts/db_scan.ts",
        "regen_ids": "tsx ./src/scripts/regen_ids.ts",
        "compile": "tsc -p . --pretty",
        "dev": "tsx --watch ./src/index.ts",
        "build": "pnpm run generate && pnpm run compile",
        "start": "node ."
    },
    "dependencies": {
        "@apollo/server": "^4.9.2",
        "axios": "^1.4.0",
        "better-auth": "catalog:",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-fileupload": "^1.4.0",
        "graphql": "^16.7.1",
        "graphql-scalars": "^1.22.4",
        "himalayan-drumming-research-auth": "workspace:*",
        "himalayan-drumming-research-database": "workspace:*",
        "module-alias": "^2.2.3",
        "nexus": "^1.3.0",
        "tsconfig-paths": "^4.2.0",
        "zod": "^3.22.2"
    },
    "devDependencies": {
        "@paralleldrive/cuid2": "^2.2.2",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/express-fileupload": "^1.4.1",
        "@types/node": "catalog:",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "eslint": "catalog:",
        "eslint-import-resolver-typescript": "catalog:",
        "eslint-plugin-import": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    },
    "_moduleAliases": {
        "@": "./dist"
    }
}