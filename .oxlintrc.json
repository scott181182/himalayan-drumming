{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "import",
    "jsdoc",
    "jsx-a11y",
    "promise",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "nextjs",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "eslint/no-undefined": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "oxc/no-async-await": "off",
    "promise/always-return": "off",
    "react/forbid-component-props": "off",
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx"] }],
    "react/jsx-max-depth": "off",
    "react/jsx-no-literals": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": ["warn", { "prefer": "type-imports" }],
    "typescript/explicit-function-return-type": "off",
    "typescript/prefer-readonly-parameter-types": [
      "warn",
      { "allow": ["Readonly"], "ignoreInferredTypes": true }
    ],
    "typescript/strict-boolean-expressions": "off",
    // Covered by TypeScript compiler flag.
    "typescript/consistent-return": "off"
  },
  "overrides": [
    {
      "files": ["src/app/**/page.tsx", "src/app/**/layout.tsx", "src/app/**/route.ts"],
      "rules": {
        "import/no-default-export": "off",
        "typescript/explicit-module-boundary-types": "off"
      }
    },
    {
      "files": ["src/**/*.tsx", "src/app/**/route.ts"],
      "rules": {
        "typescript/explicit-function-return-type": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["src/generated/**/*"]
}
