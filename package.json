{
    "name": "himalayan-drumming-research",
    "version": "0.2.0",
    "repository": "git@github.com:scott181182/himalayan-drumming.git",
    "author": "Scott Fasone <scott.fasone@bixford.digital>",
    "packageManager": "pnpm@10.22.0",
    "license": "MIT",
    "private": true,
    "scripts": {
        "build:deps": "pnpm run -r -F 'himalayan-drumming-research-server^...' -F 'himalayan-drumming-research-frontend^...' build",
        "postinstall": "node ./scripts/postinstall.js",
        "typecheck": "pnpm run -r typecheck",
        "lint": "pnpm run -r lint",
        "lint:fix": "pnpm run -r lint:fix",
        "generate": "pnpm run -r --sequential generate",
        "build": "pnpm run -r build"
    }
}