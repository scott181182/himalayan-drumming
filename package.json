    "@flystorage/local-fs": "^1.2.0",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-prisma": "^4.15.0",
    "@zenstackhq/better-auth": "^3.8.3",
    "@zenstackhq/orm": "^3.8.3",
    "@zenstackhq/schema": "^3.8.3",
    "antd": "^6.5.2",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "graphql": "^16.14.2",
