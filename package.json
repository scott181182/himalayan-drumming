{
  "name": "dialects-of-dohl",
  "version": "0.3.2",
  "private": true,
  "author": "Scott Fasone <scott.fasone@bixford.digital>",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -p . --pretty --noEmit",
    "check": "pnpm run --no-bail '/^(fmt|lint|typecheck)$/'",
    "check:fix": "pnpm run --sequential '/^(fmt:fix|lint:fix|typecheck)$/'",
    "db:migrate": "zen migrate dev",
    "db:generate": "zen generate && prisma generate --schema=./src/generated/schema.prisma",
    "graphql:generate:schema": "tsx scripts/generate-graphql",
    "graphql:generate:documents": "graphql-codegen",
    "generate": "pnpm run --sequential '/^.*:generate(:.*)?$/'"
  },
  "dependencies": {
    "@apollo/client": "^4.2.8",
    "@aws-sdk/client-s3": "^3.1101.0",
