    "mime-types": "^3.0.2",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "pluralize": "^8.0.0",
    "radashi": "^12.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "rxjs": "^7.8.2",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
