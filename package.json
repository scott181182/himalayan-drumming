    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "^6.19.3",
    "rc-select": "^14.16.8",
    "rc-table": "^7.55.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
